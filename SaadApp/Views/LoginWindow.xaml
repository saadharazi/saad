<Window x:Class="SaadApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول"
        Width="920" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}">

    <Border Background="{StaticResource WindowBackgroundBrush}"
            CornerRadius="16"
            Margin="12"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- مع RightToLeft يظهر العمود الأول على اليمين -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ===================== نموذج تسجيل الدخول ===================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- شريط العنوان (إغلاق / تصغير) - يظهر في الزاوية العلوية اليمنى -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" Margin="10">
                    <Button x:Name="CloseButton" Content="&#xE8BB;"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click" ToolTip="إغلاق" />
                    <Button x:Name="MinimizeButton" Content="&#xE921;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click" ToolTip="تصغير" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Width="340" VerticalAlignment="Center">

                    <TextBlock Text="مرحباً بعودتك"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="سجّل دخولك للمتابعة إلى حسابك"
                               FontSize="14" Margin="0,6,0,32"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- اسم المستخدم -->
                    <TextBlock Text="اسم المستخدم" FontSize="13" Margin="0,0,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Style="{StaticResource InputContainerStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE77B;" Style="{StaticResource InputIconStyle}" />
                            <TextBox x:Name="UsernameTextBox" Grid.Column="1" Margin="12,0,0,0"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Tag="أدخل اسم المستخدم" />
                        </Grid>
                    </Border>

                    <!-- كلمة المرور -->
                    <TextBlock Text="كلمة المرور" FontSize="13" Margin="0,20,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Style="{StaticResource InputContainerStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" Style="{StaticResource InputIconStyle}" />
                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <PasswordBox x:Name="PasswordInput"
                                             Style="{StaticResource InputPasswordBoxStyle}"
                                             PasswordChanged="PasswordInput_PasswordChanged" />
                                <TextBlock x:Name="PasswordPlaceholder"
                                           Text="أدخل كلمة المرور"
                                           FontSize="14" Margin="2,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- تذكرني / نسيت كلمة المرور -->
                    <Grid Margin="0,16,0,28">
                        <CheckBox x:Name="RememberMeCheckBox" Content="تذكرني"
                                  Style="{StaticResource CheckBoxStyle}"
                                  HorizontalAlignment="Left" />
                        <Button x:Name="ForgotPasswordButton" Content="نسيت كلمة المرور؟"
                                Style="{StaticResource LinkButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- زر الدخول -->
                    <Button x:Name="LoginButton" Content="تسجيل الدخول"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" />

                    <!-- رسالة خطأ (مخفية حالياً - للتصميم فقط) -->
                    <Border x:Name="ErrorMessageBorder" Margin="0,16,0,0"
                            Background="#33E74C3C" CornerRadius="8" Padding="12,8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorMessageText"
                                   Text="اسم المستخدم أو كلمة المرور غير صحيحة"
                                   Foreground="#FF7675" FontSize="13" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- التذييل -->
                <TextBlock Grid.Row="2" Text="الإصدار 1.0.0"
                           FontSize="11" Margin="0,0,0,16"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Grid>

            <!-- ===================== اللوحة الجانبية (الهوية) ===================== -->
            <!-- CornerRadius منعكس بسبب RightToLeft: الزوايا المدوّرة تظهر على اليسار -->
            <Border Grid.Column="1" CornerRadius="0,16,16,0"
                    Background="{StaticResource BrandGradientBrush}">
                <Grid ClipToBounds="True">
                    <!-- دوائر زخرفية -->
                    <Ellipse Width="260" Height="260" Fill="White" Opacity="0.08"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-90,-90,0" />
                    <Ellipse Width="180" Height="180" Fill="White" Opacity="0.06"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-60,0,0,-50" />
                    <Ellipse Width="70" Height="70" Fill="White" Opacity="0.10"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="50,110,0,0" />

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                        <!-- الشعار -->
                        <Border Width="96" Height="96" CornerRadius="24"
                                Background="#33FFFFFF" HorizontalAlignment="Center">
                            <TextBlock Text="S" FontSize="48" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="اسم التطبيق" FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,24,0,8" />
                        <TextBlock Text="وصف مختصر للتطبيق يظهر هنا، يوضح فكرته وما يقدمه للمستخدم."
                                   FontSize="14" Foreground="#E6FFFFFF"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   LineHeight="22" MaxWidth="280" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
