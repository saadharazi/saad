<Window x:Class="SaadApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOOST STORE - تسجيل الدخول"
        Width="920" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}">

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="16"
            Margin="12"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- مع RightToLeft يظهر العمود الأول على اليمين -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ===================== نموذج الدخول بالكود ===================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- شريط العنوان (إغلاق / تصغير) - يظهر في الزاوية العلوية اليمنى -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" Margin="10">
                    <Button x:Name="CloseButton" Content="&#xE8BB;"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click" ToolTip="إغلاق" />
                    <Button x:Name="MinimizeButton" Content="&#xE921;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click" ToolTip="تصغير" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Width="340" VerticalAlignment="Center">

                    <TextBlock Text="تسجيل الدخول"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="أدخل كود التفعيل الخاص بك للدخول إلى التطبيق"
                               FontSize="14" Margin="0,6,0,32" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- كود الدخول -->
                    <TextBlock Text="كود الدخول" FontSize="13" Margin="0,0,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Style="{StaticResource InputContainerStyle}" Height="52">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8D7;" Style="{StaticResource InputIconStyle}"
                                       Foreground="{StaticResource AccentBrush}" />
                            <!-- الكود بالأحرف الإنجليزية فيُكتب من اليسار لليمين -->
                            <TextBox x:Name="AccessKeyTextBox" Grid.Column="1" Margin="12,0"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     FlowDirection="LeftToRight"
                                     FontFamily="Consolas" FontSize="15"
                                     CharacterCasing="Upper" MaxLength="32"
                                     Tag="XXXX-XXXX-XXXX-XXXX" />
                            <Button x:Name="PasteButton" Grid.Column="2" Content="&#xE77F;"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    FontSize="14" Width="34" Height="34"
                                    ToolTip="لصق الكود" />
                        </Grid>
                    </Border>

                    <!-- تذكر الكود -->
                    <CheckBox x:Name="RememberKeyCheckBox" Content="تذكر الكود على هذا الجهاز"
                              Style="{StaticResource CheckBoxStyle}"
                              HorizontalAlignment="Left" Margin="0,16,0,28" />

                    <!-- زر الدخول -->
                    <Button x:Name="LoginButton" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="دخول" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- رسالة خطأ (مخفية حالياً - للتصميم فقط) -->
                    <Border x:Name="ErrorMessageBorder" Margin="0,16,0,0"
                            Background="#338B1E3F" BorderBrush="#668B1E3F" BorderThickness="1"
                            CornerRadius="8" Padding="12,8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorMessageText"
                                   Text="الكود غير صحيح أو منتهي الصلاحية"
                                   Foreground="#FF6B8B" FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- شراء كود -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock Text="ما عندك كود؟" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button x:Name="BuyKeyButton" Content="اشترِ من المتجر"
                                Style="{StaticResource LinkButtonStyle}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- التذييل: حالة الخادم + الإصدار -->
                <Grid Grid.Row="2" Margin="24,0,24,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Ellipse Width="8" Height="8" Fill="#2ECC71" VerticalAlignment="Center" />
                        <TextBlock x:Name="ServerStatusText" Text="الخادم متصل" FontSize="11"
                                   Margin="6,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Grid>

            <!-- ===================== اللوحة الجانبية (هوية BOOST STORE) ===================== -->
            <!-- CornerRadius منعكس بسبب RightToLeft: الزوايا المدوّرة تظهر على اليسار -->
            <Border Grid.Column="1" CornerRadius="0,16,16,0"
                    Background="{StaticResource BrandGradientBrush}">
                <Grid ClipToBounds="True">
                    <!-- دوائر زخرفية -->
                    <Ellipse Width="280" Height="280" Opacity="0.35"
                             Stroke="{StaticResource AccentBrush}" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-110,-110,0" />
                    <Ellipse Width="200" Height="200" Fill="#8B1E3F" Opacity="0.25"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-70,0,0,-60" />

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                        <!-- الشعار -->
                        <Border Width="96" Height="96" CornerRadius="24"
                                Background="#1AFFFFFF" BorderBrush="#66D6456E" BorderThickness="1.5"
                                HorizontalAlignment="Center">
                            <TextBlock Text="B" FontSize="52" FontWeight="Black" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="BOOST STORE" FontSize="30" FontWeight="Black"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,24,0,4" />
                        <TextBlock Text="AIM ASSIST" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,32" />

                        <!-- المميزات -->
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="تفعيل فوري بالكود" FontSize="14" Foreground="White"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="تحديثات تلقائية" FontSize="14" Foreground="White"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F2;" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="دعم فني متواصل" FontSize="14" Foreground="White"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
