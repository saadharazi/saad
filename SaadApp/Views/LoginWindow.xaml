<Window x:Class="SaadApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOOST STORE - تسجيل الدخول"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}">

    <Border Width="960" Height="600" Margin="14"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#232329" BorderThickness="1"
            CornerRadius="18"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.75" Color="Black" />
        </Border.Effect>

        <!-- القص على شكل الزوايا الدائرية (958 × 598 = الحجم الداخلي) -->
        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,958,598" RadiusX="17" RadiusY="17" />
            </Grid.Clip>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- ظهور النموذج -->
                            <DoubleAnimation Storyboard.TargetName="FormPanel" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.6" />
                            <DoubleAnimation Storyboard.TargetName="FormPanel"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="18" To="0" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- ظهور لوحة الهوية -->
                            <DoubleAnimation Storyboard.TargetName="HeroPanel" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="HeroScale" Storyboard.TargetProperty="ScaleX"
                                             From="0.92" To="1" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HeroScale" Storyboard.TargetProperty="ScaleY"
                                             From="0.92" To="1" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- حركة علامة التصويب -->
                            <DoubleAnimation Storyboard.TargetName="DashRingRotate" Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:30" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="TickRingRotate" Storyboard.TargetProperty="Angle"
                                             From="360" To="0" Duration="0:1:0" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="InnerRing" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:1.6"
                                             AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="ScanLineMove" Storyboard.TargetProperty="Y"
                                             From="0" To="296" Duration="0:0:3" RepeatBehavior="Forever" />
                            <!-- وميض النقاط -->
                            <DoubleAnimation Storyboard.TargetName="Spark1" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.2" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Spark2" Storyboard.TargetProperty="Opacity"
                                             From="0.2" To="0.9" Duration="0:0:1.9" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Spark3" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.3" Duration="0:0:2.3" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Grid.ColumnDefinitions>
                <!-- مع RightToLeft يظهر العمود الأول على اليمين -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="450" />
            </Grid.ColumnDefinitions>

            <!-- =========================================================
                 نموذج الدخول (يمين)
                 ========================================================= -->
            <Grid Grid.Column="0">
                <!-- توهج خفيف أعلى الزاوية -->
                <Ellipse Width="260" Height="220" Fill="#8B1E3F" Opacity="0.22"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-60,-120,0,0" IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <BlurEffect Radius="110" />
                    </Ellipse.Effect>
                </Ellipse>

                <Grid Margin="56,22,56,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- الشعار -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PrimaryButtonBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B1E3F" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                            <TextBlock Text="B" FontSize="17" FontWeight="Black" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BOOST STORE" FontSize="13.5" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="AIM ASSIST" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- النموذج -->
                    <StackPanel x:Name="FormPanel" Grid.Row="1" VerticalAlignment="Center" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="تسجيل الدخول" FontSize="30" FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="أدخل كود التفعيل للوصول إلى لوحة التحكم"
                                   FontSize="14" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- كود التفعيل -->
                        <TextBlock Text="كود التفعيل" FontSize="12.5" FontWeight="SemiBold" Margin="0,30,0,8"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Background="#268B1E3F">
                                    <TextBlock Text="&#xE8D7;" Style="{StaticResource IconGlyphStyle}" FontSize="14" />
                                </Border>
                                <!-- الكود بالأحرف الإنجليزية فيُكتب من اليسار لليمين -->
                                <TextBox x:Name="AccessKeyTextBox" Grid.Column="1" Margin="12,0"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         FlowDirection="LeftToRight"
                                         FontFamily="{StaticResource MonoFont}" FontSize="15"
                                         CharacterCasing="Upper" MaxLength="32"
                                         Tag="XXXX-XXXX-XXXX-XXXX" />
                                <Button x:Name="PasteButton" Grid.Column="2" Content="لصق"
                                        Style="{StaticResource InlineButtonStyle}" ToolTip="لصق الكود" />
                            </Grid>
                        </Border>

                        <!-- تذكرني -->
                        <CheckBox x:Name="RememberKeyCheckBox" Content="تذكرني على هذا الجهاز" IsChecked="True"
                                  Style="{StaticResource CheckBoxStyle}"
                                  HorizontalAlignment="Left" Margin="0,14,0,22" />

                        <!-- زر الدخول -->
                        <Button x:Name="LoginButton" Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True" Click="LoginButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="دخول" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- رسالة خطأ (مخفية حالياً - للتصميم فقط) -->
                        <Border x:Name="ErrorMessageBorder" Margin="0,14,0,0"
                                Background="#26E0304F" BorderBrush="#55E0304F" BorderThickness="1"
                                CornerRadius="10" Padding="12,9" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}"
                                           Foreground="#FF6B8B" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="ErrorMessageText" Text="الكود غير صحيح أو منتهي الصلاحية"
                                           Foreground="#FF6B8B" FontSize="13" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- فاصل "أو" -->
                        <Grid Margin="0,22,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="أو" FontSize="12" Margin="12,0"
                                       Foreground="{StaticResource TextFaintBrush}" />
                            <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource BorderBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- شراء كود / الدعم الفني -->
                        <UniformGrid Columns="2">
                            <Button x:Name="StoreButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" Style="{StaticResource IconGlyphStyle}" FontSize="14" />
                                    <TextBlock Text="شراء كود" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SupportButton" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BD;" Style="{StaticResource IconGlyphStyle}" FontSize="14" />
                                    <TextBlock Text="الدعم الفني" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- التذييل -->
                    <Grid Grid.Row="2">
                        <Border Style="{StaticResource SuccessPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#2ECC71" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="ServerStatusText" Text="الخادم متصل" FontSize="11" FontWeight="SemiBold"
                                           Margin="7,0,0,0" Foreground="{StaticResource SuccessTextBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- =========================================================
                 لوحة الهوية + علامة التصويب (يسار)
                 ========================================================= -->
            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Border.Background>
                    <!-- الإحداثيات منعكسة بسبب RightToLeft لكن التدرج متماثل -->
                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.85" RadiusY="0.7">
                        <GradientStop Color="#3A0C1C" Offset="0" />
                        <GradientStop Color="#1A070E" Offset="0.45" />
                        <GradientStop Color="#0A0A0C" Offset="0.85" />
                    </RadialGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- الشبكة -->
                    <Rectangle Fill="{StaticResource GridPatternBrush}">
                        <Rectangle.OpacityMask>
                            <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.7" RadiusY="0.55">
                                <GradientStop Color="Black" Offset="0.1" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <!-- توهج خلف علامة التصويب -->
                    <Ellipse Width="320" Height="320" Fill="#B02A55" Opacity="0.35"
                             VerticalAlignment="Top" Margin="0,70,0,0" IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <BlurEffect Radius="120" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- نقاط متوهجة -->
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="Spark1" Canvas.Left="70" Canvas.Top="120" Width="4" Height="4"
                                 Fill="{StaticResource AccentBrush}" Effect="{StaticResource AccentGlow}" />
                        <Ellipse Canvas.Left="380" Canvas.Top="90" Width="3" Height="3" Fill="White" Opacity="0.5" />
                        <Ellipse x:Name="Spark2" Canvas.Left="360" Canvas.Top="330" Width="3" Height="3"
                                 Fill="{StaticResource AccentBrush}" Effect="{StaticResource AccentGlow}" />
                        <Ellipse x:Name="Spark3" Canvas.Left="100" Canvas.Top="380" Width="2.5" Height="2.5"
                                 Fill="White" />
                        <Ellipse Canvas.Left="400" Canvas.Top="220" Width="2" Height="2" Fill="White" Opacity="0.4" />
                    </Canvas>

                    <!-- أزرار التحكم (أعلى اليسار) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,10,10,0">
                        <Button x:Name="MinimizeButton" Content="&#xE921;"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click" ToolTip="تصغير" />
                        <Button x:Name="CloseButton" Content="&#xE8BB;"
                                Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click" ToolTip="إغلاق" Margin="4,0,0,0" />
                    </StackPanel>

                    <!-- المحتوى -->
                    <StackPanel x:Name="HeroPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="HeroScale" ScaleX="1" ScaleY="1" />
                        </StackPanel.RenderTransform>

                        <!-- علامة التصويب -->
                        <Grid Width="308" Height="308">
                            <!-- زوايا إطار HUD -->
                            <Path Data="M1,37 L1,1 L37,1 M271,1 L307,1 L307,37 M307,271 L307,307 L271,307 M37,307 L1,307 L1,271"
                                  Stroke="#77E0507A" StrokeThickness="2" />

                            <Grid Width="280" Height="280">
                                <!-- حلقة التدريج (تدور ببطء) -->
                                <Ellipse Stroke="#99E0507A" StrokeThickness="12"
                                         StrokeDashArray="0.17 1.78" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.OpacityMask>
                                        <RadialGradientBrush>
                                            <GradientStop Color="Black" Offset="0.9" />
                                            <GradientStop Color="#40000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.OpacityMask>
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="TickRingRotate" Angle="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- الحلقة المنقطة (تدور) -->
                                <Ellipse Width="236" Height="236" Stroke="#88E0507A" StrokeThickness="1.5"
                                         StrokeDashArray="3 5" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="DashRingRotate" Angle="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <Ellipse Width="170" Height="170" Stroke="#20FFFFFF" StrokeThickness="1" />

                                <!-- خط المسح (داخل الدائرة فقط) -->
                                <Grid Width="256" Height="256" IsHitTestVisible="False">
                                    <Grid.Clip>
                                        <EllipseGeometry Center="128,128" RadiusX="118" RadiusY="118" />
                                    </Grid.Clip>
                                    <Rectangle Height="40" VerticalAlignment="Top" Margin="0,-40,0,0">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00E0507A" Offset="0" />
                                                <GradientStop Color="#33E0507A" Offset="0.95" />
                                                <GradientStop Color="#AAE0507A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="ScanLineMove" Y="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>

                                <!-- الحلقة الداخلية (تنبض) -->
                                <Ellipse x:Name="InnerRing" Width="110" Height="110"
                                         Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#E0507A" BlurRadius="22" ShadowDepth="0" Opacity="1" />
                                    </Ellipse.Effect>
                                </Ellipse>

                                <!-- خطوط التصويب -->
                                <Path Data="M140,40 L140,102 M140,178 L140,240 M40,140 L102,140 M178,140 L240,140"
                                      Stroke="White" StrokeThickness="2.5" Opacity="0.92"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                <!-- النقطة المركزية -->
                                <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#E0507A" BlurRadius="20" ShadowDepth="0" Opacity="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>

                        <!-- الاسم -->
                        <TextBlock Text="BOOST STORE" FontSize="34" FontWeight="Black" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,18,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#8B1E3F" BlurRadius="30" ShadowDepth="0" Opacity="1" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="تحكم أدق · استجابة أسرع · أداء أعلى" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />

                        <!-- المميزات -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Border Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="13,9">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                        <Path Data="M7,0 L7,3.5 M7,10.5 L7,14 M0,7 L3.5,7 M10.5,7 L14,7"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                    </Grid>
                                    <TextBlock Text="دقة عالية" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="13,9" Margin="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource IconGlyphStyle}" FontSize="13" />
                                    <TextBlock Text="استجابة فورية" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="13,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyphStyle}" FontSize="13" />
                                    <TextBlock Text="حماية كاملة" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
