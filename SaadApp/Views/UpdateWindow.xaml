<Window x:Class="SaadApp.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOOST STORE - تحديث"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}">

    <Border Width="520" Height="400" Margin="14"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#232329" BorderThickness="1"
            CornerRadius="18"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.75" Color="Black" />
        </Border.Effect>

        <!-- 518 × 398 = الحجم الداخلي -->
        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,518,398" RadiusX="17" RadiusY="17" />
            </Grid.Clip>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.5" />
                            <DoubleAnimation Storyboard.TargetName="IconRingRotate" Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:2.4" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="ArrowMove" Storyboard.TargetProperty="Y"
                                             From="-3" To="3" Duration="0:0:0.8"
                                             AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <!-- الخلفية -->
            <Rectangle Fill="{StaticResource GridPatternBrush}">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.25" GradientOrigin="0.5,0.25" RadiusX="0.7" RadiusY="0.6">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Ellipse Width="300" Height="220" Fill="#8B1E3F" Opacity="0.35"
                     VerticalAlignment="Top" Margin="0,-70,0,0" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- أزرار التحكم -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,10,10,0">
                <Button x:Name="MinimizeButton" Content="&#xE921;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="MinimizeButton_Click" ToolTip="تصغير" />
                <Button x:Name="CloseButton" Content="&#xE8BB;"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click" ToolTip="إغلاق" Margin="4,0,0,0" />
            </StackPanel>

            <StackPanel x:Name="ContentPanel" Width="400" VerticalAlignment="Center" Opacity="0">
                <!-- أيقونة التحديث -->
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse Stroke="#44E0507A" StrokeThickness="1.5" StrokeDashArray="3 4" />
                    <Path Data="M 48,1 A 47,47 0 0 1 95,48"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Effect="{StaticResource AccentGlow}">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="IconRingRotate" Angle="0" CenterX="48" CenterY="48" />
                        </Path.RenderTransform>
                    </Path>
                    <Ellipse Margin="13">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.3" Center="0.5,0.4" RadiusX="0.7" RadiusY="0.7">
                                <GradientStop Color="#C8356A" Offset="0" />
                                <GradientStop Color="#6E1430" Offset="0.75" />
                                <GradientStop Color="#3A0C1C" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#B02A55" BlurRadius="30" ShadowDepth="0" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="ArrowMove" Y="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <TextBlock Text="تحديث جديد متوفر" FontSize="24" FontWeight="Black" Margin="0,22,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="يجب تحديث التطبيق إلى آخر نسخة للمتابعة" FontSize="13" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />

                <!-- الإصدارات -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Border Background="{StaticResource SurfaceDeepBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14,7">
                        <StackPanel>
                            <TextBlock Text="الحالي" FontSize="10.5" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="CurrentVersionText" Text="v20.1" FontSize="14" FontWeight="Bold"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="14,0"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PillStyle}" CornerRadius="10" Padding="14,7">
                        <StackPanel>
                            <TextBlock Text="الجديد" FontSize="10.5" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="NewVersionText" Text="v20.2" FontSize="14" FontWeight="Bold"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Center" Foreground="White" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,24,0,0"
                        IsDefault="True" Click="DownloadButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="تحميل التحديث" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
