<Window x:Class="SaadApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOOST STORE - Aim Assist"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}">

    <Border Width="1140" Height="740" Margin="14"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.7" Color="Black" />
        </Border.Effect>

        <!-- القص على شكل الزوايا الدائرية (1138 × 738 = الحجم الداخلي) -->
        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,1138,738" RadiusX="15" RadiusY="15" />
            </Grid.Clip>

            <!-- دوران الحلقة الخارجية لعلامة التصويب -->
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HeroRingRotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:24"
                                             RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="HeroInnerRing"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:1.6"
                                             AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <!-- ===================== طبقات الخلفية ===================== -->
            <Rectangle Fill="{StaticResource GridPatternBrush}" Opacity="0.7">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.8" RadiusY="0.9">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <Ellipse Width="420" Height="300" Fill="#8B1E3F" Opacity="0.30"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="120,-120,0,0" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="160" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- ===================== المحتوى ===================== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============ شريط العنوان ============ -->
                <Border Grid.Row="0" Background="Transparent"
                        BorderBrush="#1A1A1F" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="20,0,12,0">
                        <!-- الشعار (يمين) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="9"
                                    Background="{StaticResource PrimaryButtonBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B1E3F" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />
                                </Border.Effect>
                                <TextBlock Text="B" FontSize="16" FontWeight="Black" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="BOOST STORE" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}"
                                       Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock Text="AIM ASSIST" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- الحالة + أزرار التحكم (يسار) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#142ECC71" CornerRadius="20" Padding="10,4"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#2ECC71" VerticalAlignment="Center" />
                                    <TextBlock Text="متصل" FontSize="11" Margin="6,0,0,0" Foreground="#7FD8A0" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="MinimizeButton" Content="&#xE921;"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Click="MinimizeButton_Click" ToolTip="تصغير" />
                            <Button x:Name="CloseButton" Content="&#xE8BB;"
                                    Style="{StaticResource CloseButtonStyle}"
                                    Click="CloseButton_Click" ToolTip="إغلاق" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ جسم الشاشة ============ -->
                <Grid Grid.Row="1" Margin="20">
                    <Grid.ColumnDefinitions>
                        <!-- مع RightToLeft: العمود الأول يمين (الرئيسي) والثالث يسار (الجانبي) -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <!-- ================= العمود الرئيسي ================= -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ====== بطاقة التشغيل الرئيسية ====== -->
                        <Border Grid.Row="0" CornerRadius="18" Padding="26,22"
                                BorderBrush="#3A1522" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1C0C13" Offset="0" />
                                    <GradientStop Color="#131316" Offset="0.6" />
                                    <GradientStop Color="#1A0B11" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <!-- شارة الحالة -->
                                    <Border Style="{StaticResource PillStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock FontSize="11" FontWeight="Bold" Margin="8,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="متوقف" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=AimAssistToggle}" Value="True">
                                                                <Setter Property="Text" Value="يعمل الآن" />
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- العنوان + المفتاح الكبير -->
                                    <Grid Margin="0,12,0,0">
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="Aim Assist" FontSize="30" FontWeight="Black"
                                                       Foreground="White" />
                                            <TextBlock Text="تحكم كامل بمساعد التصويب من مكان واحد"
                                                       FontSize="13" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <CheckBox x:Name="AimAssistToggle" IsChecked="True"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,24,0">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </Grid>

                                    <!-- النمط + زر التفعيل السريع -->
                                    <Grid Margin="0,22,0,0">
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="النمط" FontSize="12" Margin="0,0,0,8"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                            <Border Style="{StaticResource SegmentedContainerStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="ناعم" GroupName="Mode"
                                                                 Style="{StaticResource SegmentedRadioStyle}" />
                                                    <RadioButton Content="متوازن" GroupName="Mode" IsChecked="True"
                                                                 Style="{StaticResource SegmentedRadioStyle}" />
                                                    <RadioButton Content="قوي" GroupName="Mode"
                                                                 Style="{StaticResource SegmentedRadioStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel HorizontalAlignment="Right" Margin="0,0,24,0">
                                            <TextBlock Text="زر التفعيل السريع" FontSize="12" Margin="0,0,0,8"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                            <Border Background="#0D0D10" BorderBrush="#33333A" BorderThickness="1,1,1,3"
                                                    CornerRadius="8" Height="36" MinWidth="64" Padding="14,0"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="F1" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- علامة التصويب -->
                                <Viewbox Grid.Column="1" Width="170" Height="170"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=AimAssistToggle}" Value="False">
                                                    <Setter Property="Opacity" Value="0.25" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Grid Width="260" Height="260">
                                        <Path Data="M0,34 L0,0 L34,0 M226,0 L260,0 L260,34 M260,226 L260,260 L226,260 M34,260 L0,260 L0,226"
                                              Stroke="#668B1E3F" StrokeThickness="3" />
                                        <Ellipse Width="236" Height="236"
                                                 Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                 StrokeDashArray="2 6" Opacity="0.7"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="HeroRingRotate" Angle="0" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="180" Height="180" Stroke="#26FFFFFF" StrokeThickness="1.5" />
                                        <Ellipse x:Name="HeroInnerRing" Width="110" Height="110"
                                                 Stroke="{StaticResource AccentBrush}" StrokeThickness="3">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#D6456E" BlurRadius="20" ShadowDepth="0" Opacity="0.9" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Path Data="M130,30 L130,98 M130,162 L130,230 M30,130 L98,130 M162,130 L230,130"
                                              Stroke="White" StrokeThickness="3" Opacity="0.85"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#D6456E" BlurRadius="16" ShadowDepth="0" Opacity="1" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- ====== بطاقات الضبط (2 × 2) ====== -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- قوة التثبيت -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconBadgeStyle}">
                                                <TextBlock Text="&#xE945;" Style="{StaticResource IconBadgeGlyphStyle}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="قوة التثبيت" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="مدى قوة سحب التصويب نحو الهدف" Style="{StaticResource CardSubtitleStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="20" FontWeight="Bold" Foreground="White"
                                                   Text="{Binding Value, ElementName=StrengthSlider, StringFormat={}{0:0}%}" />
                                    </Grid>
                                    <Slider x:Name="StrengthSlider" Grid.Row="1" VerticalAlignment="Bottom"
                                            Minimum="0" Maximum="100" Value="75"
                                            Style="{StaticResource AimSliderStyle}" />
                                </Grid>
                            </Border>

                            <!-- النعومة -->
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconBadgeStyle}">
                                                <TextBlock Text="&#xE9D9;" Style="{StaticResource IconBadgeGlyphStyle}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="النعومة" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="حركة أكثر سلاسة وطبيعية" Style="{StaticResource CardSubtitleStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="20" FontWeight="Bold" Foreground="White"
                                                   Text="{Binding Value, ElementName=SmoothSlider, StringFormat={}{0:0}%}" />
                                    </Grid>
                                    <Slider x:Name="SmoothSlider" Grid.Row="1" VerticalAlignment="Bottom"
                                            Minimum="0" Maximum="100" Value="40"
                                            Style="{StaticResource AimSliderStyle}" />
                                </Grid>
                            </Border>

                            <!-- مجال الرؤية -->
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconBadgeStyle}">
                                                <TextBlock Text="&#xE890;" Style="{StaticResource IconBadgeGlyphStyle}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="مجال الرؤية (FOV)" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="حجم الدائرة التي يعمل داخلها المساعد" Style="{StaticResource CardSubtitleStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="20" FontWeight="Bold" Foreground="White"
                                                   Text="{Binding Value, ElementName=FovSlider, StringFormat={}{0:0}°}" />
                                    </Grid>
                                    <Slider x:Name="FovSlider" Grid.Row="1" VerticalAlignment="Bottom"
                                            Minimum="10" Maximum="360" Value="120"
                                            Style="{StaticResource AimSliderStyle}" />
                                </Grid>
                            </Border>

                            <!-- سرعة الاستجابة -->
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconBadgeStyle}">
                                                <TextBlock Text="&#xE916;" Style="{StaticResource IconBadgeGlyphStyle}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="سرعة الاستجابة" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="الوقت قبل بدء التثبيت على الهدف" Style="{StaticResource CardSubtitleStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="20" FontWeight="Bold" Foreground="White"
                                                   Text="{Binding Value, ElementName=ReactionSlider, StringFormat={}{0:0}ms}" />
                                    </Grid>
                                    <Slider x:Name="ReactionSlider" Grid.Row="1" VerticalAlignment="Bottom"
                                            Minimum="0" Maximum="200" Value="15"
                                            Style="{StaticResource AimSliderStyle}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ====== خيارات سريعة ====== -->
                        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="18,14">
                            <UniformGrid Columns="3">
                                <Grid Margin="0,0,14,0">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="إظهار دائرة FOV" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                                        <TextBlock Text="عرض المجال على الشاشة" Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="True" Style="{StaticResource ToggleSwitchStyle}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="7,0">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="التنبؤ بالحركة" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                                        <TextBlock Text="توقع اتجاه الهدف" Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="True" Style="{StaticResource ToggleSwitchStyle}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="14,0,0,0">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="الهدف الأقرب" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                                        <TextBlock Text="أولوية للأقرب للمؤشر" Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <!-- ================= العمود الجانبي ================= -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ====== الاشتراك ====== -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Style="{StaticResource IconBadgeStyle}">
                                            <TextBlock Text="&#xE8D7;" Style="{StaticResource IconBadgeGlyphStyle}" />
                                        </Border>
                                        <TextBlock Text="الاشتراك" Style="{StaticResource CardTitleStyle}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="#142ECC71" CornerRadius="20" Padding="10,3"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="نشط" FontSize="11" FontWeight="SemiBold" Foreground="#7FD8A0" />
                                    </Border>
                                </Grid>

                                <Border Background="#0D0D10" CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
                                    <TextBlock x:Name="KeyText" Text="BST-••••-••••-7F2A" FlowDirection="LeftToRight"
                                               FontFamily="Consolas" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>

                                <Grid Margin="0,14,0,8">
                                    <TextBlock Text="المدة المتبقية" FontSize="12" VerticalAlignment="Bottom"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="DaysLeftText" Text="27" FontSize="22" FontWeight="Bold"
                                                   Foreground="White" />
                                        <TextBlock Text="يوم" FontSize="12" Margin="6,0,0,3" VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Value="90" Maximum="100" Style="{StaticResource SlimProgressBarStyle}" />
                                <TextBlock x:Name="ExpiryText" Text="ينتهي في 2026/10/21" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- ====== نقطة الاستهداف ====== -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconBadgeStyle}">
                                        <Grid Width="16" Height="16">
                                            <Ellipse Width="9" Height="9" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                            <Path Data="M8,0 L8,4 M8,12 L8,16 M0,8 L4,8 M12,8 L16,8"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="نقطة الاستهداف" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="الجزء الذي يتم التثبيت عليه" Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <!-- الخيارات -->
                                    <StackPanel VerticalAlignment="Center">
                                        <RadioButton x:Name="TargetHeadRadio" Content="الرأس" GroupName="Target"
                                                     IsChecked="True" HorizontalContentAlignment="Left"
                                                     Style="{StaticResource SegmentedRadioStyle}" />
                                        <RadioButton x:Name="TargetChestRadio" Content="الصدر" GroupName="Target"
                                                     HorizontalContentAlignment="Left" Margin="0,6,0,0"
                                                     Style="{StaticResource SegmentedRadioStyle}" />
                                        <RadioButton x:Name="TargetBodyRadio" Content="الجسم" GroupName="Target"
                                                     HorizontalContentAlignment="Left" Margin="0,6,0,0"
                                                     Style="{StaticResource SegmentedRadioStyle}" />
                                    </StackPanel>

                                    <!-- مجسم الجسم (يتلون الجزء المختار) -->
                                    <Canvas Grid.Column="1" Width="90" Height="130"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Canvas.Left="32" Canvas.Top="0" Width="26" Height="26">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#26262C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TargetHeadRadio}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#D6456E" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Rectangle Canvas.Left="20" Canvas.Top="31" Width="50" Height="44"
                                                   RadiusX="12" RadiusY="12">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="#26262C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TargetChestRadio}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#D6456E" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle Canvas.Left="25" Canvas.Top="79" Width="40" Height="51"
                                                   RadiusX="10" RadiusY="10">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="#26262C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TargetBodyRadio}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#D6456E" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ====== الأداء ====== -->
                        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Style="{StaticResource IconBadgeStyle}">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource IconBadgeGlyphStyle}" />
                                        </Border>
                                        <TextBlock Text="الأداء" Style="{StaticResource CardTitleStyle}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Right"
                                            Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="أداء عالي" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>

                                <!-- المعالج -->
                                <Grid Margin="0,16,0,6">
                                    <TextBlock Text="استخدام المعالج" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="3%" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="3" Style="{StaticResource SlimProgressBarStyle}" Height="4" />

                                <!-- الذاكرة -->
                                <Grid Margin="0,12,0,6">
                                    <TextBlock Text="الذاكرة" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="48 MB" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="12" Style="{StaticResource SlimProgressBarStyle}" Height="4" />

                                <!-- زمن الاستجابة -->
                                <Grid Margin="0,12,0,6">
                                    <TextBlock Text="زمن التأخير" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="1 ms" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="5" Style="{StaticResource SlimProgressBarStyle}" Height="4" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
