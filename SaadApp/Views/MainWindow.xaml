<Window x:Class="SaadApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOOST STORE - Aim Assist"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}"
        Loaded="Window_Loaded" Closed="Window_Closed" KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- قيمة شريط التمرير داخل شارة -->
        <Style x:Key="ValueBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#268B1E3F" />
            <Setter Property="BorderBrush" Value="#558B1E3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <Style x:Key="TickTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>

        <!-- تلوين جزء الجسم المختار -->
        <Style x:Key="BodyPartStyle" TargetType="Shape">
            <Setter Property="Fill" Value="#24242A" />
            <Setter Property="Stroke" Value="#2E2E36" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border Width="1180" Height="760" Margin="14"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#232329" BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.75" Color="Black" />
        </Border.Effect>

        <!-- القص على شكل الزوايا الدائرية (1178 × 758 = الحجم الداخلي) -->
        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,1178,758" RadiusX="15" RadiusY="15" />
            </Grid.Clip>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- ظهور المحتوى -->
                            <DoubleAnimation Storyboard.TargetName="BodyGrid" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.6" />
                            <DoubleAnimation Storyboard.TargetName="BodyGrid"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="16" To="0" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- وميض LIVE -->
                            <DoubleAnimation Storyboard.TargetName="LiveDot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.2" Duration="0:0:0.8"
                                             AutoReverse="True" RepeatBehavior="Forever" />
                            <!-- نبض الهدف في المعاينة -->
                            <DoubleAnimation Storyboard.TargetName="PreviewTargetHead" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.55" Duration="0:0:0.9"
                                             AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <!-- ===================== طبقات الخلفية ===================== -->
            <Rectangle Fill="{StaticResource GridPatternBrush}">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.8" RadiusY="0.9">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <Ellipse Width="460" Height="300" Fill="#8B1E3F" Opacity="0.35"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-160,200,0" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="150" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="300" Height="300" Fill="#8B1E3F" Opacity="0.18"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-60,0,0,-160" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="130" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- ===================== المحتوى ===================== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ================= شريط العنوان ================= -->
                <Border Grid.Row="0" Background="Transparent"
                        BorderBrush="#17171B" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="20,0,12,0">
                        <!-- الشعار (يمين) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PrimaryButtonBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B1E3F" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                                <TextBlock Text="B" FontSize="17" FontWeight="Black" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BOOST STORE" FontSize="14" FontWeight="ExtraBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="AIM ASSIST" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- الحالة + أزرار التحكم (يسار) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Style="{StaticResource SuccessPillStyle}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#2ECC71" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="ConnectionText" Text="متصل" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0"
                                               Foreground="{StaticResource SuccessTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="MinimizeButton" Content="&#xE921;"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Click="MinimizeButton_Click" ToolTip="تصغير" />
                            <Button x:Name="CloseButton" Content="&#xE8BB;"
                                    Style="{StaticResource CloseButtonStyle}"
                                    Click="CloseButton_Click" ToolTip="إغلاق" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= جسم الشاشة ================= -->
                <Grid x:Name="BodyGrid" Grid.Row="1" Margin="22" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <!-- مع RightToLeft: العمود الأول يمين (الرئيسي) والثالث يسار (الجانبي) -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- ============================================
                         العمود الرئيسي
                         ============================================ -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="262" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="290" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ====== بطاقة التشغيل ====== -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18,16"
                                    BorderBrush="#3A1522">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                        <GradientStop Color="#1E0C14" Offset="0" />
                                        <GradientStop Color="#111114" Offset="0.65" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="Aim Assist" FontSize="15" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="التشغيل الرئيسي" Style="{StaticResource CardSubtitleStyle}" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CornerRadius="20" Padding="11,4" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1FE0507A" />
                                                    <Setter Property="BorderBrush" Value="#44E0507A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=AimAssistToggle}" Value="False">
                                                            <Setter Property="Background" Value="#10FFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#22FFFFFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=AimAssistToggle}" Value="False">
                                                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                                    <Setter Property="Effect" Value="{x:Null}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="11" FontWeight="Bold" Margin="7,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="يعمل" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=AimAssistToggle}" Value="False">
                                                                    <Setter Property="Text" Value="متوقف" />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- زر التشغيل الدائري -->
                                    <CheckBox x:Name="AimAssistToggle" Grid.Row="1" IsChecked="True"
                                              Style="{StaticResource PowerButtonStyle}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- زر التبديل السريع -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="تبديل سريع" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <Border Style="{StaticResource KeyCapStyle}" Margin="8,0,0,0">
                                            <TextBlock Text="F1" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ====== المعاينة المباشرة ====== -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconBadgeStyle}">
                                                <TextBlock Text="&#xE890;" Style="{StaticResource IconGlyphStyle}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="معاينة مباشرة" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="شكل المساعد على الشاشة" Style="{StaticResource CardSubtitleStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- النمط -->
                                        <Border Style="{StaticResource SegmentedContainerStyle}" Padding="3"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ModeSmoothRadio" Content="ناعم" GroupName="Mode" Height="26"
                                                             Style="{StaticResource SegmentedRadioStyle}" />
                                                <RadioButton x:Name="ModeBalancedRadio" Content="متوازن" GroupName="Mode" Height="26" IsChecked="True"
                                                             Style="{StaticResource SegmentedRadioStyle}" />
                                                <RadioButton x:Name="ModeStrongRadio" Content="قوي" GroupName="Mode" Height="26"
                                                             Style="{StaticResource SegmentedRadioStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- شاشة المعاينة -->
                                    <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="12"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.7" RadiusY="0.9">
                                                <GradientStop Color="#1A0E13" Offset="0" />
                                                <GradientStop Color="#08080A" Offset="0.8" />
                                            </RadialGradientBrush>
                                        </Border.Background>

                                        <Grid ClipToBounds="True">
                                            <Rectangle Fill="{StaticResource GridPatternBrush}" Opacity="0.8" />

                                            <!-- محتوى المعاينة (يبهت عند الإيقاف) -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=AimAssistToggle}" Value="False">
                                                                <Setter Property="Opacity" Value="0.25" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <!-- دائرة FOV: حجمها مربوط بشريط مجال الرؤية -->
                                                <Ellipse Width="{Binding Value, ElementName=FovSlider}"
                                                         Height="{Binding Value, ElementName=FovSlider}"
                                                         Stroke="#AAE0507A" StrokeThickness="1.5" StrokeDashArray="4 3"
                                                         Fill="#148B1E3F"
                                                         Visibility="{Binding IsChecked, ElementName=ShowFovToggle, Converter={StaticResource BoolToVisibility}}"
                                                         RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>

                                                <!-- الهدف وخط التصويب (الإحداثيات من مركز الشاشة) -->
                                                <Canvas Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Line X1="0" Y1="0" X2="42" Y2="-30"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                                          StrokeDashArray="3 2" Opacity="0.8" />
                                                    <Rectangle Canvas.Left="28" Canvas.Top="-20" Width="28" Height="36"
                                                               RadiusX="9" RadiusY="9" Fill="#2A2A31" />
                                                    <Ellipse x:Name="PreviewTargetHead" Canvas.Left="34" Canvas.Top="-39"
                                                             Width="16" Height="16" Fill="{StaticResource AccentBrush}">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#E0507A" BlurRadius="16" ShadowDepth="0" Opacity="1" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Canvas>

                                                <!-- علامة التصويب في المنتصف -->
                                                <Ellipse Width="26" Height="26" Stroke="White" StrokeThickness="2" Opacity="0.9" />
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                                                         Effect="{StaticResource AccentGlow}" />
                                            </Grid>

                                            <!-- LIVE -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,10,12,0" FlowDirection="LeftToRight">
                                                <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#E74C3C" VerticalAlignment="Center">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#E74C3C" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="#FF8A80"
                                                           Margin="6,0,0,0" />
                                            </StackPanel>

                                            <!-- القيم الحالية -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10"
                                                    Background="#99000000" BorderBrush="{StaticResource BorderStrongBrush}"
                                                    BorderThickness="1" CornerRadius="20" Padding="11,4">
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" FlowDirection="LeftToRight"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="FOV {0:0}° · {1:0}%">
                                                            <Binding ElementName="FovSlider" Path="Value" />
                                                            <Binding ElementName="StrengthSlider" Path="Value" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ====== بطاقات الضبط (2 × 2) ====== -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- قوة التثبيت -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconBadgeStyle}">
                                                <TextBlock Text="&#xE945;" Style="{StaticResource IconGlyphStyle}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="قوة التثبيت" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="مدى سحب التصويب نحو الهدف" Style="{StaticResource CardSubtitleStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource ValueBadgeStyle}">
                                            <TextBlock Style="{StaticResource ValueTextStyle}"
                                                       Text="{Binding Value, ElementName=StrengthSlider, StringFormat={}{0:0}%}" />
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="StrengthSlider" Grid.Row="1" VerticalAlignment="Bottom"
                                            Minimum="0" Maximum="100" Value="75"
                                            Style="{StaticResource AimSliderStyle}" />
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock Text="0" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Text="50" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="100" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- النعومة -->
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconBadgeStyle}">
                                                <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyphStyle}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="النعومة" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="حركة أكثر سلاسة وطبيعية" Style="{StaticResource CardSubtitleStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource ValueBadgeStyle}">
                                            <TextBlock Style="{StaticResource ValueTextStyle}"
                                                       Text="{Binding Value, ElementName=SmoothSlider, StringFormat={}{0:0}%}" />
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SmoothSlider" Grid.Row="1" VerticalAlignment="Bottom"
                                            Minimum="0" Maximum="100" Value="40"
                                            Style="{StaticResource AimSliderStyle}" />
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock Text="0" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Text="50" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="100" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- مجال الرؤية -->
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconBadgeStyle}">
                                                <Grid Width="16" Height="16">
                                                    <Ellipse Width="14" Height="14" Stroke="{StaticResource AccentBrush}"
                                                             StrokeThickness="1.5" StrokeDashArray="2 1.5" />
                                                    <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="مجال الرؤية FOV" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="حجم دائرة عمل المساعد" Style="{StaticResource CardSubtitleStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource ValueBadgeStyle}">
                                            <TextBlock Style="{StaticResource ValueTextStyle}"
                                                       Text="{Binding Value, ElementName=FovSlider, StringFormat={}{0:0}°}" />
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="FovSlider" Grid.Row="1" VerticalAlignment="Bottom"
                                            Minimum="20" Maximum="200" Value="120"
                                            Style="{StaticResource AimSliderStyle}" />
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock Text="20°" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Text="110°" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="200°" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- سرعة الاستجابة -->
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconBadgeStyle}">
                                                <TextBlock Text="&#xE916;" Style="{StaticResource IconGlyphStyle}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="سرعة الاستجابة" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="الوقت قبل بدء التثبيت" Style="{StaticResource CardSubtitleStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource ValueBadgeStyle}">
                                            <TextBlock Style="{StaticResource ValueTextStyle}"
                                                       Text="{Binding Value, ElementName=ReactionSlider, StringFormat={}{0:0}ms}" />
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="ReactionSlider" Grid.Row="1" VerticalAlignment="Bottom"
                                            Minimum="0" Maximum="200" Value="15"
                                            Style="{StaticResource AimSliderStyle}" />
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock Text="0" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Text="100" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="200ms" Style="{StaticResource TickTextStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ====== خيارات سريعة ====== -->
                        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="إظهار دائرة FOV" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                                        <TextBlock Text="عرض المجال على الشاشة" Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ShowFovToggle" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" />
                                <Grid Grid.Column="2" Margin="16,0">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="التنبؤ بالحركة" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                                        <TextBlock Text="توقع اتجاه الهدف" Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PredictionToggle" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Rectangle Grid.Column="3" Fill="{StaticResource BorderBrush}" />
                                <Grid Grid.Column="4" Margin="16,0,0,0">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="الهدف الأقرب" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                                        <TextBlock Text="أولوية للأقرب للمؤشر" Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ClosestTargetToggle" Style="{StaticResource ToggleSwitchStyle}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================
                         العمود الجانبي
                         ============================================ -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ====== بطاقة الاشتراك (Premium) ====== -->
                        <Border Grid.Row="0" CornerRadius="16" BorderBrush="#66B02A55" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#9E2449" Offset="0" />
                                    <GradientStop Color="#5E1029" Offset="0.45" />
                                    <GradientStop Color="#1A070E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#8B1E3F" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.35" />
                            </Border.Effect>

                            <!-- 358 × 198 = الحجم الداخلي للبطاقة -->
                            <Grid>
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,358,198" RadiusX="15" RadiusY="15" />
                                </Grid.Clip>

                                <!-- زخارف -->
                                <TextBlock Text="B" FontSize="220" FontWeight="Black" Foreground="#0CFFFFFF"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Margin="0,0,-10,-80" />
                                <Ellipse Width="200" Height="200" Stroke="#18FFFFFF" StrokeThickness="1"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-60,0" />
                                <Ellipse Width="140" Height="140" Stroke="#12FFFFFF" StrokeThickness="1"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-50,-20,0" />

                                <Grid Margin="20,18,20,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="BOOST" FontSize="10" FontWeight="SemiBold" Foreground="#A0FFFFFF" />
                                            <TextBlock x:Name="PlanText" Text="PREMIUM" FontSize="18" FontWeight="Black" Foreground="White"
                                                       FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="#1FFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                CornerRadius="20" Padding="11,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#2ECC71" BlurRadius="6" ShadowDepth="0" Opacity="1" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Text="نشط" FontSize="11" FontWeight="Bold" Foreground="White" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="KeyText" Grid.Row="1" Text="••••"
                                               FontFamily="{StaticResource MonoFont}" FontSize="15"
                                               Foreground="#D0FFFFFF" FlowDirection="LeftToRight"
                                               HorizontalAlignment="Left" Margin="0,16,0,0" />

                                    <Grid Grid.Row="3">
                                        <TextBlock Text="المدة المتبقية" FontSize="11" Foreground="#A0FFFFFF"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock x:Name="DaysLeftText" Text="27" FontSize="26" FontWeight="Black"
                                                       Foreground="White" />
                                            <TextBlock x:Name="DaysUnitText" Text="يوم" FontSize="12" Foreground="#B0FFFFFF"
                                                       Margin="6,0,0,5" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar x:Name="RemainingBar" Grid.Row="4" Value="100" Margin="0,6,0,0"
                                                 Style="{StaticResource SlimProgressBarStyle}"
                                                 Foreground="White" Background="#50000000">
                                        <ProgressBar.Effect>
                                            <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.5" />
                                        </ProgressBar.Effect>
                                    </ProgressBar>
                                    <TextBlock x:Name="ExpiryText" Grid.Row="5" Text=""
                                               FontSize="10.5" Foreground="#90FFFFFF" Margin="0,8,0,0" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ====== نقطة الاستهداف ====== -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconBadgeStyle}">
                                        <Grid Width="16" Height="16">
                                            <Ellipse Width="9" Height="9" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                            <Path Data="M8,0 L8,4 M8,12 L8,16 M0,8 L4,8 M12,8 L16,8"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="نقطة الاستهداف" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="الجزء الذي يتم التثبيت عليه" Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <!-- الخيارات -->
                                    <Border Style="{StaticResource SegmentedContainerStyle}" VerticalAlignment="Center">
                                        <StackPanel>
                                            <RadioButton x:Name="TargetHeadRadio" Content="الرأس" GroupName="Target"
                                                         IsChecked="True" Style="{StaticResource OptionRadioStyle}" />
                                            <RadioButton x:Name="TargetChestRadio" Content="الصدر" GroupName="Target"
                                                         Margin="0,3,0,0" Style="{StaticResource OptionRadioStyle}" />
                                            <RadioButton x:Name="TargetBodyRadio" Content="الجسم" GroupName="Target"
                                                         Margin="0,3,0,0" Style="{StaticResource OptionRadioStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- مجسم الجسم -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Ellipse Width="110" Height="110" Fill="#8B1E3F" Opacity="0.25" IsHitTestVisible="False">
                                            <Ellipse.Effect>
                                                <BlurEffect Radius="40" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Canvas Width="90" Height="128" HorizontalAlignment="Center">
                                            <Ellipse Canvas.Left="31" Canvas.Top="0" Width="28" Height="28">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource BodyPartStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=TargetHeadRadio}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Rectangle Canvas.Left="18" Canvas.Top="32" Width="54" Height="44"
                                                       RadiusX="13" RadiusY="13">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle" BasedOn="{StaticResource BodyPartStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=TargetChestRadio}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <Rectangle Canvas.Left="23" Canvas.Top="80" Width="44" Height="48"
                                                       RadiusX="11" RadiusY="11">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle" BasedOn="{StaticResource BodyPartStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=TargetBodyRadio}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Canvas>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ====== الأداء ====== -->
                        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Style="{StaticResource IconBadgeStyle}">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyphStyle}" />
                                        </Border>
                                        <TextBlock Text="الأداء" Style="{StaticResource CardTitleStyle}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Right" Padding="10,3">
                                        <TextBlock x:Name="PerformanceLabel" Text="أداء عالي" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,14,0,0">
                                    <Border Style="{StaticResource StatTileStyle}" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock x:Name="CpuText" Style="{StaticResource StatValueStyle}" Text="0%" />
                                            <TextBlock Text="المعالج" Style="{StaticResource CardSubtitleStyle}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatTileStyle}" Margin="4,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource StatValueStyle}">
                                                <Run x:Name="RamValue" Text="0" /><Run Text=" MB" FontSize="11" FontWeight="SemiBold"
                                                                      Foreground="{StaticResource TextSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="الذاكرة" Style="{StaticResource CardSubtitleStyle}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatTileStyle}" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource StatValueStyle}">
                                                <Run x:Name="LatencyValue" Text="-" /><Run Text=" ms" FontSize="11" FontWeight="SemiBold"
                                                                     Foreground="{StaticResource TextSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="الاتصال" Style="{StaticResource CardSubtitleStyle}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- منحنى زمن الاتصال بالخادم (آخر القياسات) -->
                                <Viewbox Stretch="Fill" Height="44" Margin="0,12,0,0">
                                    <Canvas Width="320" Height="46">
                                        <Polygon x:Name="LatencyArea" Points="0,46 320,46">
                                            <Polygon.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#59E0507A" Offset="0" />
                                                    <GradientStop Color="#00E0507A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Polygon.Fill>
                                        </Polygon>
                                        <Polyline x:Name="LatencyLine" Points="0,40 320,40"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                  StrokeLineJoin="Round" Effect="{StaticResource AccentGlow}" />
                                    </Canvas>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
